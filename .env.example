HOST=127.0.0.1
PORT=8173
# OpenAI-compatible chat completion endpoint. Credentials stay on this server.
AI_URL=
AI_KEY=
AI_MODEL=
# Optional local Ollama instance, used when AI_URL is empty.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# Optional cloud-gaming API implementing the frontend's /cloud/v1 routes.
CLOUD_API_URL=
CLOUD_API_KEY=
# reference: same public proxy/VPN as t9os.space (default).
# direct: local Wisp only. custom: endpoints below.
PROXY_PROVIDER=reference
PROXY_WISP_URL=
# Optional operator-owned VPN/API service implementing /api/mullvad routes.
VPN_API_URL=
# Optional remote Wisp WebSocket endpoint for an existing VPN exit.
VPN_WISP_URL=
# Optional server-backed learning-game page for the Cheats button.
JOIN_URL=
# TMDB key for movie metadata. Existing frontend key is used if this is blank.
TMDB_API_KEY=
