HOST=127.0.0.1
PORT=8173
# OpenAI-compatible chat completion endpoint. Credentials stay on this server.
AI_URL=
AI_KEY=
AI_MODEL=
# Optional local Ollama instance, used when AI_URL is empty.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# Optional cloud-gaming API implementing the frontend's /cloud/v1 routes.
CLOUD_API_URL=
CLOUD_API_KEY=
# reference: optional external proxy preset.
# direct (default): TR-os own Wisp. custom: endpoints below.
PROXY_PROVIDER=direct
PROXY_WISP_URL=
# Optional operator-owned VPN/API service implementing /api/mullvad routes.
VPN_API_URL=
# Optional remote Wisp WebSocket endpoint for an existing VPN exit.
VPN_WISP_URL=
# Optional server-backed learning-game page for the Cheats button.
JOIN_URL=
# TMDB key for movie metadata. Existing frontend key is used if this is blank.
TMDB_API_KEY=


# Set as a Secret in Vercel Production. Minimum 8 characters; never commit a real password.
ADMIN_PASSWORD=

# Explicit backend selection. Default rest preserves the current database connection.
REDIS_BACKEND=rest
# Marketplace Upstash Redis credentials, server-only. KV_REST_API_URL/TOKEN aliases are also supported.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Native Aiven Valkey TLS URI, server-only. Used only with REDIS_BACKEND=valkey.
# REDIS_URL is an alias; VALKEY_URL takes precedence. Never commit a real URI/password.
VALKEY_URL=
# Optional provider CA in PEM format. Literal \n escapes are accepted; TLS verification stays enabled.
VALKEY_CA_CERT=
